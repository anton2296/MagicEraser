    "Onboard1Text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We present to you a unique app that will help get rid of unwanted objects in your shots and make them perfect!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Представляем вам уникальное приложение, которое поможет избавиться от ненужных объектов на ваших снимках!"
          }
        }
      }
    },
    "Onboard1Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No more unnecessary details in photos!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устали от лишних деталей на фотографиях?"
          }
        }
      }
    },
    "Onboard2Text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the area you want to remove.\nThe app will automatically delete unnecessary objects from the photo.\nThe result will look natural and realistic"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите область, которую хотите удалить.\nПриложение автоматически удалит лишние объекты с фотографии.\nРезультат будет выглядеть естественно и реалистично"
          }
        }
      }
    },
    "Onboard2Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How does our app work?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как работает наше приложение?"
          }
        }
      }
    },
    "Onboard3Text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't miss the opportunity to subscribe to our app and create high-quality photos without unnecessary objects, even without Internet access!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не упустите возможность приобрести подписку на наше приложение и создавать качественные фотографии без лишних объектов, даже без доступа в интернет!"
          }
        }
      }
    },
    "Onboard3Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With our app, you can easily and quickly edit your photos, making them ideal. "
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С нашим приложением вы сможете легко и быстро редактировать свои фотографии, делая их идеальными"
